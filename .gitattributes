*.unity filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text

# Line ending rules
* text=auto
*.cs text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binaries - no conversion
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.mp3 binary
*.wav binary
*.prefab binary
*.asset binary
*.mat binary
*.anim binary